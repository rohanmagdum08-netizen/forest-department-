NODE_ENV=development
PORT=8000
SESSION_SECRET=replace-with-a-long-random-value
DATABASE_URL=postgresql://postgres:password@localhost:5432/forestguard360
PGSSL=false
ADMIN_NAME=Forest Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters

# Cloudinary: create an account, then copy the API credentials from its dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
